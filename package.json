{
  "name": "kiln",
  "private": true,
  "description": "Kiln: a themeable React design system, form library and shared tooling configs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint lint:root format:check",
    "lint:root": "eslint --max-warnings=0 --ignore-pattern 'apps/**' --ignore-pattern 'packages/**' .",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:react18": "turbo run test:react18",
    "test:storybook": "turbo run test:storybook",
    "check:package": "turbo run check:package",
    "check:links": "turbo run check:links",
    "size": "turbo run size",
    "generate:skills": "pnpm --filter @mitcsutt/kiln-docs generate:skills"
  },
  "prettier": "@mitcsutt/kiln-prettier-config",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@mitcsutt/kiln-eslint-config": "workspace:*",
    "@mitcsutt/kiln-prettier-config": "workspace:*",
    "@mitcsutt/kiln-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "lightningcss": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.11.0"
  }
}
