{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#format:check": {
      "inputs": ["$TURBO_ROOT$/**", "!$TURBO_ROOT$/**/node_modules/**", "!$TURBO_ROOT$/.turbo/**"],
      "outputs": []
    }
  }
}
