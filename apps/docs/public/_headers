# Response headers for the static assets on Cloudflare Workers (ADR 0034). Next copies this
# file into out/, and Wrangler applies it instead of serving it.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The demo app's bundles, copied in by scripts/copy-demo.ts (ADR 0050): Vite hashes every name.
/demo-app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/markdown; charset=utf-8

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8

/api/search
  Content-Type: application/json; charset=utf-8
