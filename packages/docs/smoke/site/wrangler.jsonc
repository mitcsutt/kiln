// Static assets only, as a kiln-docs site deploys (ADR 0034). The smoke test never deploys: it
// serves `out/` with `wrangler dev` for `kiln-docs check-links`.
{
  "name": "kiln-docs-smoke",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
