{
  // The entries and the bin that Node runs as written, outside a bundler (ADR 0046): erasable
  // syntax only, so Node can strip their types. `tsconfig.json` checks the rest, the chrome
  // included, which imports kiln-ui's source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/config.ts",
    "src/generate.ts",
    "src/mdx-config.ts",
    "src/next.ts",
    "src/themes.ts",
    "src/variants.ts",
    "src/node/*.ts"
  ],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
