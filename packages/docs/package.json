{
  "name": "@mitcsutt/kiln-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Kiln docs: Kiln chrome for fumadocs-core, a docs site foundation built with kiln-ui",
  "homepage": "https://kiln.mitchellsutton.com",
  "bugs": "https://github.com/mitcsutt/kiln/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitcsutt/kiln.git",
    "directory": "packages/docs"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./generate": "./src/generate.ts",
    "./mdx-config": "./src/mdx-config.ts",
    "./next": "./src/next.ts",
    "./variants": "./src/variants.ts",
    "./layout": "./src/layouts/root.tsx",
    "./docs-layout": "./src/layouts/docs.tsx",
    "./docs-page": "./src/layouts/page.tsx",
    "./not-found": "./src/layouts/notFound.tsx",
    "./shell": "./src/layouts/shell.tsx",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "kiln-docs": "./bin/kiln-docs.js"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "node-html-parser": "^9.0.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mitcsutt/kiln-tsconfig": "workspace:*",
    "@mitcsutt/kiln-ui": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.148.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mitcsutt/kiln-ui": ">=0.8.0 <1.0.0",
    "fumadocs-core": "~16.15.18",
    "fumadocs-mdx": "~15.4.6",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wrangler": "^4.0.0",
    "zod": "^4.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
