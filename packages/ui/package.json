{
  "name": "@mitcsutt/kiln-ui",
  "version": "0.6.0",
  "description": "Kiln: a themeable React design system on Radix primitives, plain CSS and design tokens",
  "keywords": [
    "kiln",
    "react",
    "design-system",
    "components",
    "ui",
    "radix",
    "css-modules",
    "design-tokens",
    "theming",
    "tanstack-intent"
  ],
  "homepage": "https://kiln.mitchellsutton.com",
  "bugs": "https://github.com/mitcsutt/kiln/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitcsutt/kiln.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "kiln-dist": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./theme-script": {
      "kiln-dist": {
        "types": "./dist/theme/script.d.ts",
        "default": "./dist/theme/script.js"
      },
      "node": {
        "types": "./dist/theme/script.d.ts",
        "default": "./dist/theme/script.js"
      },
      "default": "./src/theme/script.ts"
    },
    "./highlight": {
      "kiln-dist": {
        "types": "./dist/highlight/index.d.ts",
        "default": "./dist/highlight/index.js"
      },
      "default": "./src/highlight/index.ts"
    },
    "./styles.css": {
      "kiln-dist": "./dist/styles.css",
      "default": "./src/styles/index.css"
    },
    "./themes/monograph.css": {
      "kiln-dist": "./dist/themes/monograph.css",
      "default": "./src/themes/monograph.css"
    },
    "./themes/ledger.css": {
      "kiln-dist": "./dist/themes/ledger.css",
      "default": "./src/themes/ledger.css"
    },
    "./themes/fiesta.css": {
      "kiln-dist": "./dist/themes/fiesta.css",
      "default": "./src/themes/fiesta.css"
    },
    "./themes/flightdeck.css": {
      "kiln-dist": "./dist/themes/flightdeck.css",
      "default": "./src/themes/flightdeck.css"
    },
    "./themes/riso.css": {
      "kiln-dist": "./dist/themes/riso.css",
      "default": "./src/themes/riso.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme-script": {
        "types": "./dist/theme/script.d.ts",
        "default": "./dist/theme/script.js"
      },
      "./highlight": {
        "types": "./dist/highlight/index.d.ts",
        "default": "./dist/highlight/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./themes/monograph.css": "./dist/themes/monograph.css",
      "./themes/ledger.css": "./dist/themes/ledger.css",
      "./themes/fiesta.css": "./dist/themes/fiesta.css",
      "./themes/flightdeck.css": "./dist/themes/flightdeck.css",
      "./themes/riso.css": "./dist/themes/riso.css",
      "./package.json": "./package.json"
    },
    "imports": {}
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "check:package": "pnpm pack --out node_modules/.cache/kiln-pack/package.tgz > /dev/null && publint --pack pnpm --strict && attw node_modules/.cache/kiln-pack/package.tgz --profile esm-only --exclude-entrypoints ./styles.css ./themes/monograph.css ./themes/ledger.css ./themes/fiesta.css ./themes/flightdeck.css ./themes/riso.css && node scripts/check-theme-script-entry.ts node_modules/.cache/kiln-pack/package.tgz",
    "check:skills": "intent validate",
    "lint": "eslint --max-warnings=0 .",
    "size": "node ../../size-report.ts",
    "test": "vitest run",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "radix-ui": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@mitcsutt/kiln-testing-react18": "workspace:*",
    "@mitcsutt/kiln-tsconfig": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "shiki": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
