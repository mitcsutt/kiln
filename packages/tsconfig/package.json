{
  "name": "@mitcsutt/kiln-tsconfig",
  "version": "0.2.0",
  "description": "Shared TypeScript presets for Kiln and the projects that use it",
  "keywords": [
    "kiln",
    "tsconfig",
    "typescript",
    "config"
  ],
  "homepage": "https://kiln.mitchellsutton.com",
  "bugs": "https://github.com/mitcsutt/kiln/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitcsutt/kiln.git",
    "directory": "packages/tsconfig"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./base": "./base.json",
    "./base.json": "./base.json",
    "./react": "./react.json",
    "./react.json": "./react.json",
    "./library": "./library.json",
    "./library.json": "./library.json",
    "./app": "./app.json",
    "./app.json": "./app.json",
    "./react-app": "./react-app.json",
    "./react-app.json": "./react-app.json",
    "./node": "./node.json",
    "./node.json": "./node.json",
    "./package.json": "./package.json"
  },
  "files": [
    "*.json",
    "!tsconfig.json"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
